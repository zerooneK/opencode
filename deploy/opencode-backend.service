[Unit]
Description=OpenCode Backend API Server
After=network.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__PROJECT_DIR__
Environment=NODE_ENV=production
ExecStart=__BUN_PATH__ run --conditions=browser ./packages/opencode/src/index.ts serve --port 4096 --hostname 0.0.0.0 --cors http://__SERVER_IP__:3927
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
